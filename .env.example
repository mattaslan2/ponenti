# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables. Never commit real values.

# --- Requested by the brief ---------------------------------------------------
# Attio CRM API key (server only). Workspace settings > Developers > Access tokens.
# Scopes: record_permission:read-write, object_configuration:read, note:read-write.
ATTIO_API_KEY=
# Resend API key (server only). Used for the visitor confirmation and your alert.
RESEND_API_KEY=
# PostHog project API key (US cloud). Loads only after cookie consent.
NEXT_PUBLIC_POSTHOG_KEY=
# Sentry DSN. One value feeds both server and browser error monitoring.
SENTRY_DSN=
# Cal.com event path, e.g. ponenti/15min (or the full https://cal.com/... link).
NEXT_PUBLIC_CAL_LINK=
# WhatsApp number in international format, digits only, e.g. 14045550100.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Client portal link. Leave as /portal until the portal app exists, then set
# e.g. https://portal.yourdomain.com. Nothing else needs to change.
NEXT_PUBLIC_PORTAL_URL=/portal

# --- Needed to run the above ---------------------------------------------------
# Sender for lead emails, on a domain verified in Resend (SPF, DKIM, DMARC).
LEADS_FROM_EMAIL="Ponenti <merhaba@yourdomain.com>"
# Where new-lead alerts go.
LEADS_ALERT_EMAIL=
# Canonical site URL (no trailing slash). Defaults to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=
# Search engines are blocked until this is "true". Set it at launch.
SITE_INDEXABLE=false

# --- Switches (leave unset in production unless the condition is met) ----------
# "true" only after your E&O carrier confirms the penalty promise is covered.
NEXT_PUBLIC_EO_CONFIRMED=
# "true" on Preview only, to see hidden proof slots as marked boxes.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=

# --- Optional: Sentry source maps ----------------------------------------------
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Local testing only (leave unset everywhere else) ---------------------------
# Point the lead flow at a mock server instead of the real APIs.
# ATTIO_API_URL=http://localhost:4010/v2
# RESEND_BASE_URL=http://localhost:4010
